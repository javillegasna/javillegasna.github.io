---
import { type CollectionEntry, getCollection, render } from 'astro:content';

import ContactCTA from '../../components/ContactCTA.astro';
import Hero from '../../components/Hero.astro';
import Icon from '../../components/Icon.astro';
import Pill from '../../components/Pill.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

interface Props {
	entry: CollectionEntry<'writing'>;
}

// One page per published (non-draft) Markdown file in src/content/writing/.
export async function getStaticPaths() {
	const writing = await getCollection('writing', ({ data }) => !data.draft);
	return writing.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const formatDate = (date: Date) =>
	date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const canonical = new URL(`/writing/${entry.id}/`, Astro.site);
---

<BaseLayout
	title={`${entry.data.title} | Javier Villegas`}
	description={entry.data.description}
	canonical={canonical}
	ogType="article"
>
	<div class="stack gap-20">
		<div class="stack gap-15">
			<header>
				<div class="wrapper stack gap-2">
					<a class="back-link" href="/writing/"><Icon icon="arrow-left" /> Writing</a>
					<Hero title={entry.data.title} align="start">
						<div class="details">
							<p class="dates">
								<time datetime={entry.data.publishDate.toISOString()}>
									{formatDate(entry.data.publishDate)}
								</time>
								{
									entry.data.updated && (
										<span>
											· Updated{' '}
											<time datetime={entry.data.updated.toISOString()}>
												{formatDate(entry.data.updated)}
											</time>
										</span>
									)
								}
							</p>
							<div class="tags">
								{entry.data.tags.map((t) => <Pill>{t}</Pill>)}
							</div>
						</div>
					</Hero>
				</div>
			</header>
			<main class="wrapper">
				<article class="content">
					<Content />
				</article>
				<a class="back-link bottom" href="/writing/"><Icon icon="arrow-left" /> All writing</a>
			</main>
		</div>
		<ContactCTA />
	</div>
</BaseLayout>

<style>
	header {
		padding-bottom: 2.5rem;
		border-bottom: 1px solid var(--gray-800);
	}

	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		align-self: flex-start;
	}

	.back-link.bottom {
		display: flex;
		max-width: 68ch;
		margin: 3rem auto 0;
	}

	.details {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding: 0.5rem 0;
	}

	.dates {
		font-size: var(--text-md);
		color: var(--gray-300);
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.content {
		max-width: 68ch;
		margin-inline: auto;
		font-size: var(--text-md);
		line-height: 1.7;
	}

	.content > :global(* + *) {
		margin-top: 1.25rem;
	}

	.content :global(h2),
	.content :global(h3),
	.content :global(h4) {
		margin: 2.5rem 0 1rem;
		line-height: 1.25;
		color: var(--gray-0);
	}

	.content :global(h2) {
		font-size: var(--text-xl);
	}

	.content :global(h3) {
		font-size: var(--text-lg);
	}

	.content :global(ul),
	.content :global(ol) {
		padding-inline-start: 1.5rem;
	}

	.content :global(li + li) {
		margin-top: 0.5rem;
	}

	.content :global(code) {
		font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
		font-size: 0.9em;
	}

	.content :global(:not(pre) > code) {
		padding: 0.1em 0.35em;
		border-radius: 0.375rem;
		background-color: var(--gray-800);
		color: var(--gray-0);
	}

	.content :global(pre) {
		padding: 1rem 1.25rem;
		border-radius: 0.75rem;
		border: 1px solid var(--gray-800);
		box-shadow: var(--shadow-sm);
		overflow-x: auto;
		font-size: var(--text-sm);
		line-height: 1.6;
	}

	.content :global(pre code) {
		font-size: inherit;
	}

	.content :global(blockquote) {
		padding-inline-start: 1.25rem;
		border-inline-start: 0.25rem solid var(--accent-dark);
		color: var(--gray-100);
	}

	.content :global(table) {
		width: 100%;
		border-collapse: collapse;
		font-size: var(--text-base);
	}

	.content :global(th),
	.content :global(td) {
		padding: 0.5rem 0.75rem;
		border-bottom: 1px solid var(--gray-800);
		text-align: start;
	}

	.back-link,
	.content :global(a) {
		text-decoration: 1px solid underline;
		text-decoration-color: transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.content :global(a) {
		text-decoration-color: var(--accent-overlay);
	}

	.back-link:hover,
	.back-link:focus,
	.content :global(a:hover),
	.content :global(a:focus) {
		text-decoration-color: currentColor;
	}

	@media (min-width: 50em) {
		.details {
			flex-direction: row;
			align-items: center;
			gap: 2rem;
		}

		.content {
			font-size: var(--text-lg);
		}
	}
</style>
